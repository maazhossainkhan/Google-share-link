Options -Indexes
RewriteEngine On

# Keep real files and directories accessible.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# A Canvau short code resolves through the Supabase redirect Edge Function.
RewriteRule ^([A-Za-z0-9_-]{5,12})/?$ go.php?code=$1 [L,QSA,NC]

<FilesMatch "^(config\.php)$">
  Require all denied
</FilesMatch>
